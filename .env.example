# Postgres connection string (Supabase, Neon, Railway, or local Postgres all work)
DATABASE_URL="postgresql://user:password@localhost:5432/echelon_united"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string" # generate: openssl rand -base64 32

# Web Push (VAPID keys) — required for real browser push notifications.
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# File storage (Documents section) — backed by Supabase Storage.
# 1. Create a Supabase project (or reuse the one behind DATABASE_URL if you're
#    already on Supabase Postgres).
# 2. In the dashboard: Storage → New bucket → name it "files"
#    (or set SUPABASE_STORAGE_BUCKET below to match a different name).
#    The bucket can be Private — this app always serves files through
#    short-lived signed URLs generated server-side, never a public bucket URL.
# 3. Project Settings → API → copy the Project URL and the
#    service_role secret key (NOT the anon/public key — service_role is
#    required for server-side uploads and must never be exposed to the client).
#    Paste your own values below in your real .env file — never commit or
#    share this key; if it's ever pasted somewhere public, rotate it
#    immediately from Project Settings → API.
SUPABASE_URL="https://btaknidlakerswoxxvhi.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ0YWtuaWRsYWtlcnN3b3h4dmhpIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4ODAyOTIyNSwiZXhwIjoyMTAzNjA1MjI1fQ.eNMZ8jpGtDOYFlz_IHliSsJbY_nm8j1tbbjmooYWdPI"
SUPABASE_STORAGE_BUCKET="files"
